@PACKAGE_INIT@

# btp::codec has no dependencies. btp::aead links mbedcrypto privately, and is
# only present in this package when it was built against an mbedtls the
# consumer's environment also provides.
include(CMakeFindDependencyMacro)

if(NOT TARGET mbedcrypto AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/btpTargets.cmake")
    file(READ "${CMAKE_CURRENT_LIST_DIR}/btpTargets.cmake" _btp_targets_content)
    if(_btp_targets_content MATCHES "btp::aead")
        find_dependency(MbedTLS)
    endif()
    unset(_btp_targets_content)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/btpTargets.cmake")

check_required_components(btp)
