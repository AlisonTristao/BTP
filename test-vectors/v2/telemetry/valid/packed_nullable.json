{
  "format": "btp-test-vector-telemetry-v2",
  "id": "packed_nullable",
  "encoding": "PACKED_LE",
  "description": "One non-nullable float32 then three nullable fields; the middle one is null. Presence bitmap is one octet 0b00000101.",
  "schema_version": 2,
  "schema": [
    { "field_id": 1, "order": 0, "type": "float32", "scale": 1.0, "offset": 0.0 },
    { "field_id": 2, "order": 1, "type": "uint16", "scale": 1.0, "offset": 0.0, "nullable": true },
    { "field_id": 3, "order": 2, "type": "uint16", "scale": 1.0, "offset": 0.0, "nullable": true },
    { "field_id": 4, "order": 3, "type": "uint8", "scale": 1.0, "offset": 0.0, "nullable": true }
  ],
  "sample": [
    { "field_id": 1, "raw": [1.0] },
    { "field_id": 2, "raw": [500] },
    { "field_id": 3, "null": true },
    { "field_id": 4, "raw": [9] }
  ]
}
